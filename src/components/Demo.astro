---
import Icon from './Icon.astro';
import { DEMO } from '../i18n/ui';
import type { Lang } from '../data';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = DEMO[lang];

/** Palabras, citas `{D1}` y la cifra descartada `[74 %]`; los espacios se conservan entre ellas. */
type Token = { kind: 'word' | 'cite' | 'bad'; text: string } | ' ';
const tokens: Token[] = [];
for (const chunk of d.answer.split(/(\{[^}]+\}|\[[^\]]+\])/)) {
  if (chunk.startsWith('{')) tokens.push({ kind: 'cite', text: chunk.slice(1, -1) });
  else if (chunk.startsWith('[')) tokens.push({ kind: 'bad', text: chunk.slice(1, -1) });
  else
    for (const w of chunk.split(/(\s+)/))
      if (w) tokens.push(/^\s+$/.test(w) ? ' ' : { kind: 'word', text: w });
}
---

<div class="cell demo from-r" data-demo role="group" aria-label={d.label}>
  <div class="top">
    <span><i class="live" aria-hidden="true"></i><b>{d.title}</b>{d.subtitle}</span>
    <span class="tools">
      <span>{d.tag}</span>
      <button type="button" class="pause js-only" aria-pressed="false">
        {d.pause}
      </button>
    </span>
  </div>
  <table class="data">
    <caption class="sr-only">{d.tableCaption}</caption>
    <tbody>
      {
        d.rows.map((r) => (
          <tr>
            <th scope="row">{r.id}</th>
            <td>{r.source}</td>
            <td class="val">{r.value}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="q">{d.question}</p>
  <p class="a">
    {
      tokens.map((t) =>
        t === ' ' ? (
          ' '
        ) : t.kind === 'bad' ? (
          <del class="tok bad flag">{t.text}</del>
        ) : (
          <span class:list={['tok', { cite: t.kind === 'cite' }]}>{t.text}</span>
        ),
      )
    }
  </p>
  <p class="verdict"><Icon name="close" size={16} />{d.verdict}</p>
  <p class="foot">
    <span>{d.note}</span>
    <a href="#invest-ai">{d.link}</a>
  </p>
</div>

<style>
  .demo {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-16);
    padding: var(--sp-32);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-4) var(--sp-16);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .top b {
    margin-right: var(--sp-8);
    color: var(--ink);
    font-weight: 700;
  }
  .top > span {
    white-space: nowrap;
  }
  .tools {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-12);
  }
  /* Pausar el bucle (WCAG 2.2.2): mismo vocabulario que los segmentados; relleno de tinta al pulsarlo. */
  .pause {
    min-height: 32px;
    padding: 0 var(--sp-12);
    border: 1px solid var(--line);
    border-radius: var(--r-chip);
    background: var(--cell);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 700;
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .pause:hover {
    background: var(--chip);
    color: var(--ink);
  }
  .pause[aria-pressed='true'] {
    background: var(--ink);
    color: var(--cell);
  }
  @media (pointer: coarse) {
    .pause {
      min-height: 44px;
      min-width: 44px;
    }
  }
  .live {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: var(--sp-8);
    background: var(--acc);
  }
  /* Solo parpadea mientras la demo corre: sin JS, en pausa o con movimiento reducido, quieto. */
  .demo:global(.is-live) .live {
    animation: blink 1.4s var(--ease) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }

  .data {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .data th,
  .data td {
    padding: var(--sp-8) var(--sp-12);
    text-align: left;
  }
  .data tr + tr > * {
    border-top: 1px solid var(--line);
  }
  .data th {
    width: 1%;
    font-weight: 700;
  }
  .data td {
    color: var(--ink-2);
  }
  .data .val {
    width: 1%;
    color: var(--ink);
    font-weight: 700;
    text-align: right;
    white-space: nowrap;
  }

  .q {
    align-self: flex-end;
    max-width: 90%;
    padding: var(--sp-8) var(--sp-12);
    border-radius: var(--r-chip);
    background: var(--chip);
    font-size: var(--fs-base);
  }
  .a {
    font-size: var(--fs-pitch);
    line-height: 1.6;
  }
  .tok {
    transition: opacity 0.3s var(--ease);
  }
  .cite {
    padding: 0 var(--sp-4);
    border-radius: var(--r-chip);
    background: var(--acc);
    color: var(--on-acc);
    font-size: var(--fs-xs);
    font-weight: 700;
    vertical-align: 2px;
  }
  .bad {
    text-decoration: none;
    transition: color 0.4s var(--ease);
  }
  .bad.flag {
    color: var(--no);
    text-decoration: line-through;
    text-decoration-thickness: 2px;
  }
  .verdict {
    display: flex;
    align-items: center;
    gap: var(--sp-8);
    color: var(--no);
    font-size: var(--fs-sm);
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }
  .foot {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-16);
    padding-top: var(--sp-12);
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: var(--fs-sm);
  }
  .foot a {
    flex: none;
    color: var(--acc-ink);
    font-weight: 700;
    white-space: nowrap;
  }

  /* Con JavaScript la demo se reinicia y se escribe sola; sin él, o con movimiento reducido,
     se ve el estado final. */
  .demo:global(.is-live) .tok {
    opacity: 0;
  }
  .demo:global(.is-live) .tok:global(.on) {
    opacity: 1;
  }
  .demo:global(.is-live) .bad:not(:global(.flag)) {
    color: inherit;
    text-decoration: none;
  }
  .demo:global(.is-live) .verdict {
    opacity: 0;
    transform: translateY(6px);
  }
  .demo:global(.is-live) .verdict:global(.on) {
    opacity: 1;
    transform: none;
  }
  @media (pointer: coarse) {
    .foot a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
  @media (max-width: 639px) {
    .demo {
      padding: var(--sp-24);
    }
    .foot {
      flex-direction: column;
      gap: var(--sp-8);
    }
  }
</style>
