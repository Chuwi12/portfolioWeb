---
import { type Lang } from '../data';
import { GROUP_LABEL, UI } from '../i18n/ui';
import { groupSpans } from '../lib/layout';
import { noteChips, stackGroups, techCount } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = UI[lang];

/** Los grupos que filtran (con el número de proyectos) y, tras ellos, los que solo informan. */
const groups = stackGroups();
const notes = [noteChips(ui.stackArchitecture), noteChips(ui.stackSecurity)];
const spans = groupSpans([
  ...groups.map((g) => g.nets.length),
  ...notes.map((n) => n.items.length),
]);
---

<section id="stack" class="floor tier tier-scroll" aria-labelledby="stack-title">
  <div class="strip">
    <div class="lead">
      <h2 id="stack-title" class="floor-title" tabindex="-1">{ui.stackTitle}</h2>
      <p class="help js-only">{ui.stackHelp}</p>
    </div>
    <div class="result">
      <p
        id="tec-status"
        class="status"
        role="status"
        aria-live="polite"
        data-one={ui.stackOne}
        data-many={ui.stackMany}
      >
      </p>
      <ul id="tec-matches" class="matches" aria-label={ui.stackMatches}></ul>
      <button type="button" class="btn btn-sec btn-sm" data-tec-clear hidden>
        {ui.stackClear}
      </button>
    </div>
  </div>
  <div class="box">
    {
      groups.map((g, i) => (
        <div
          role="group"
          aria-labelledby={`grp-${g.group}`}
          class:list={['cell', 'group', `s${spans[i]}`, i % 2 === 0 ? 'from-l' : 'from-r']}
        >
          <h3 id={`grp-${g.group}`}>{GROUP_LABEL[lang][g.group]}</h3>
          <ul class="chips">
            {g.nets.map((n) => {
              const count = techCount(n.id);
              return (
                <li>
                  <button
                    type="button"
                    class="chip tech"
                    data-tech={n.id}
                    data-label={n.label}
                    data-group={n.group}
                    aria-pressed="false"
                  >
                    {n.label}
                    <span class="n" aria-hidden="true">
                      {count}
                    </span>
                  </button>
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
    {
      notes.map((note, i) => (
        <div
          role="group"
          aria-labelledby={`note-${i}`}
          class:list={[
            'cell',
            'group',
            `s${spans[groups.length + i]}`,
            i % 2 === 0 ? 'from-l' : 'from-r',
          ]}
        >
          <h3 id={`note-${i}`}>{note.label}</h3>
          <ul class="chips">
            {note.items.map((item) => (
              <li class="chip fixed">{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .lead {
    display: grid;
    gap: var(--sp-8);
  }
  .help {
    max-width: 34em;
    font-size: var(--fs-lg);
    font-weight: 500;
  }
  /* Resultado del filtro: vive en la tira del piso, bajo el titular. */
  .result {
    display: grid;
    justify-items: start;
    max-width: 34em;
  }
  .status {
    font-size: var(--fs-xl);
    font-weight: 700;
    line-height: 1.25;
  }
  .status:not(:empty) {
    margin-bottom: var(--sp-8);
  }
  .matches {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4) var(--sp-16);
    font-size: var(--fs-base);
  }
  .matches:not(:empty) {
    margin-bottom: var(--sp-12);
  }
  .matches :global(a) {
    color: var(--acc-ink);
    font-weight: 500;
  }

  h3 {
    margin-bottom: var(--sp-16);
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-weight: 700;
  }
  /* Chips del filtro: con borde y el número de proyectos en cifras tabulares. */
  .tech {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-8);
    border: 1px solid var(--line);
    cursor: pointer;
    transition:
      transform 0.25s var(--ease),
      background-color 0.25s var(--ease),
      border-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .n {
    color: var(--ink-2);
    font-size: var(--fs-sm);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  /* Sobre el tamago de los chips de IA la tinta secundaria no llega a 4,5:1 en oscuro. */
  .tech[data-group='ai'] .n {
    color: var(--ink);
  }
  .tech:hover,
  .tech:focus-visible {
    transform: translateY(-1px);
  }
  .tech:hover {
    background: color-mix(in srgb, var(--ink) 12%, var(--chip));
  }
  .tech[data-group='ai']:hover {
    background: color-mix(in srgb, var(--acc) 50%, var(--cell));
  }
  .tech[aria-pressed='true'] {
    border-color: var(--acc);
    background: var(--acc);
    color: var(--on-acc);
  }
  .tech[aria-pressed='true'] .n {
    color: var(--on-acc);
  }
  .fixed {
    border: 1px solid transparent;
    color: var(--ink);
  }
  @media (pointer: coarse) {
    .tech {
      min-height: 44px;
    }
  }
</style>
