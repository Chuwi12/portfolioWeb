---
import '../styles/global.css';
import font400 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-400-normal.woff2?url';
import font500 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-500-normal.woff2?url';
import font700 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-700-normal.woff2?url';
import font900 from '@fontsource/zen-kaku-gothic-new/files/zen-kaku-gothic-new-latin-900-normal.woff2?url';
import themeInit from '../scripts/theme-init.js?raw';
import { UI } from '../i18n/ui';
import { THEME_COLORS } from '../theme';
import { otherLang, SITE, url } from '../lib/site';
import type { Lang } from '../data';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Páginas sin versión por idioma (404): sin canonical, hreflang ni indexación. */
  noindex?: boolean;
}
const { lang, title, description, noindex = false } = Astro.props;
const ui = UI[lang];
const other = otherLang(lang);
const og = `${SITE}/og.png`;
---

<!doctype html>
<html lang={ui.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={THEME_COLORS.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={THEME_COLORS.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={url(lang)} />
          <link rel="alternate" hreflang="es" href={url('es')} />
          <link rel="alternate" hreflang="en" href={url('en')} />
          <link rel="alternate" hreflang="x-default" href={url('es')} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="chuwi-dev" />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={url(lang)} />
          <meta property="og:locale" content={ui.locale} />
          <meta property="og:locale:alternate" content={UI[other].locale} />
          <meta property="og:image" content={og} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={title} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={og} />
        </>
      )
    }
    <link rel="preload" as="font" type="font/woff2" href={font900} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={font700} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={font500} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={font400} crossorigin />
    <script is:inline set:html={themeInit} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{ui.skipLink}</a>
    <slot />
    <script>
      import '../scripts/main';
    </script>
    {
      import.meta.env.PROD && (
        <>
          <script is:inline defer src="/_vercel/insights/script.js" />
          <script is:inline defer src="/_vercel/speed-insights/script.js" />
        </>
      )
    }
  </body>
</html>
